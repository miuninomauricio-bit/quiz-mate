    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { getFirestore, collection, addDoc, getDocs, query, orderBy, limit, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyB-y9Uau-_13J-g9ocs74H8uMUlCTmnhao",
            authDomain: "quiz-matematicas-e68da.firebaseapp.com",
            projectId: "quiz-matematicas-e68da",
            storageBucket: "quiz-matematicas-e68da.firebasestorage.app",
            messagingSenderId: "1028636593201",
            appId: "1:1028636593201:web:e21046e904273e0bf4d910",
            measurementId: "G-098X4TEHE8"
        };

        let db = null;

        try {
            const app = initializeApp(firebaseConfig);
            const auth = getAuth(app);
            db = getFirestore(app);

            signInAnonymously(auth).catch(err => console.log("Auth anónima restringida:", err));
        } catch (e) {
            console.error("Error al inicializar Firebase:", e);
        }

        window.sendScoreToFirebase = async function(userData) {
            if (!db) return;
            try {
                await addDoc(collection(db, "rankings"), {
                    name: userData.name,
                    score: userData.score,
                    topic: userData.topic,
                    createdAt: serverTimestamp()
                });
            } catch (e) {
                console.error("Error al guardar puntaje:", e);
            }
        };

        window.fetchRankingDataFromFirebase = async function() {
            const container = document.getElementById('rankingListContainer');
            if (!db) {
                container.innerHTML = `<div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 text-center text-xs text-rose-500">Base de datos no disponible.</div>`;
                return;
            }

            container.innerHTML = `<div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 text-center text-xs text-slate-500">Cargando ranking...</div>`;
            
            try {
                const q = query(collection(db, "rankings"), orderBy("score", "desc"), limit(10));
                const querySnapshot = await getDocs(q);
                
                if (querySnapshot.empty) {
                    container.innerHTML = `<div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 text-center text-xs text-slate-500">Aún no hay puntajes registrados.</div>`;
                    return;
                }

                let htmlContent = '';
                let position = 1;
                
                querySnapshot.forEach((doc) => {
                    const data = doc.data();
                    const medalColor = position === 1 ? 'text-amber-500 font-black' : (position === 2 ? 'text-slate-400 font-bold' : (position === 3 ? 'text-amber-700 font-bold' : 'text-slate-600 dark:text-slate-400'));
                    
                    htmlContent += `
                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2">
                                <span class="${medalColor}">#${position}</span>
                                <span class="font-bold text-slate-800 dark:text-slate-200">${escapeHtml(data.name || 'Anónimo')}</span>
                                <span class="text-[10px] text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 px-2 py-0.5 rounded">(${data.topic})</span>
                            </div>
                            <span class="font-black text-amber-600 dark:text-amber-400">${data.score} / 5 pts</span>
                        </div>
                    `;
                    position++;
                });

                container.innerHTML = htmlContent;
            } catch (e) {
                console.error("Error al obtener ranking:", e);
                container.innerHTML = `<div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/30 text-center text-xs text-rose-500">Error al conectar con la base de datos.</div>`;
            }
        };

        function escapeHtml(text) {
            return text.replace(/&/g, "&").replace(/</g, "<").replace(/>/g, ">").replace(/"/g, """).replace(/'/g, "'");
        }
    </script>

    <!-- ================= SCRIPT GENERAL DE LA APP ================= -->
    <script>
        let currentTopic = '';
        let questionsList = [];
        let currentQuestionIndex = 0;
        let score = 0;
        let selectedOption = null;

        let currentUser = {
            name: "Anónimo",
            score: 0,
            topic: "",
        };

        // Inicializar preferencia de modo oscuro
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            document.getElementById('darkModeToggle').checked = true;
        } else {
            document.documentElement.classList.remove('dark');
            document.getElementById('darkModeToggle').checked = false;
        }

        function toggleDarkMode() {
