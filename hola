<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guías de Matemáticas - Semejanza y Tales</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- MathJax for rendering math formulas -->
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']]
            },
            svg: { fontCache: 'global' }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    
    <style>
        body { font-family: 'Outfit', sans-serif; }
        .gradient-bg {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #2563eb 100%);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
        .dark .glass-card {
            background: rgba(30, 41, 59, 0.95);
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body class="bg-slate-100 dark:bg-slate-900 min-h-screen text-slate-800 dark:text-slate-100 flex flex-col justify-between transition-colors duration-300">

    <!-- Header / Navbar -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-40 shadow-sm transition-colors duration-300">
        <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="goToCover()">
                <div class="w-10 h-10 rounded-xl gradient-bg flex items-center justify-center text-white shadow-md">
                    <i class="fa-solid fa-shapes text-xl"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-slate-900 dark:text-white text-lg leading-tight">Guías de Matemáticas</h1>
                    <p class="text-xs font-semibold text-indigo-600 dark:text-indigo-400">Semejanza y Teorema de Tales</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-2">
                <!-- Botón para abrir el Ranking Global de Firebase -->
                <button id="rankingBtn" onclick="openRankingModal()" class="hidden px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs transition flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-trophy"></i>
                    <span>Ranking</span>
                </button>
                <button id="navBackBtn" onclick="goToInitialChoice()" class="hidden px-3.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-semibold text-xs transition flex items-center gap-2 border border-slate-300 dark:border-slate-600">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Volver al Inicio</span>
                </button>
                <button onclick="openSettingsModal()" class="w-9 h-9 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 flex items-center justify-center transition border border-slate-300 dark:border-slate-600 shadow-sm" title="Configuración">
                    <i class="fa-solid fa-gear"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-5xl mx-auto px-4 py-8 flex-grow w-full flex items-center justify-center">

        <!-- ================= SECCIÓN 00: PORTADA INICIAL ================= -->
        <div id="coverSection" class="w-full max-w-2xl text-center space-y-8 animate-in fade-in duration-300">
            <div class="relative inline-block">
                <div class="w-28 h-28 rounded-3xl gradient-bg mx-auto flex items-center justify-center text-white shadow-2xl transform hover:scale-105 transition duration-300">
                    <i class="fa-solid fa-book-bookmark text-5xl"></i>
                </div>
                <span class="absolute -bottom-2 -right-2 bg-emerald-500 text-white p-2 rounded-full text-xs font-bold shadow-lg">
                    <i class="fa-solid fa-check"></i> 100% Interactivo
                </span>
            </div>

            <div class="space-y-3">
                <span class="px-4 py-1.5 rounded-full bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 font-bold text-xs uppercase tracking-wider">
                    Plataforma de Ejercitación
                </span>
                <h2 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
                    GUÍAS DE MATEMÁTICAS
                </h2>
                <p class="text-slate-600 dark:text-slate-300 text-base max-w-lg mx-auto leading-relaxed">
                    Aprende, ejercita y domina los conceptos de Semejanza de Figuras, Escalas, Teorema y Corolario de Tales con ejercicios dinámicos gráficos.
                </p>
            </div>

            <!-- Input de Nombre de Usuario para Firebase -->
            <div class="w-full max-w-xs mx-auto">
                <label for="usernameInput" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1 text-left">Tu Nombre o Alias para el Ranking:</label>
                <input type="text" id="usernameInput" placeholder="Ej. Estudiante Pro" maxlength="20" class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-white font-medium text-sm focus:outline-none focus:border-indigo-500 shadow-sm mb-2">
            </div>

            <button onclick="enterPlatform()" class="w-full max-w-xs py-4 px-6 rounded-xl gradient-bg text-white font-bold text-lg shadow-xl hover:shadow-2xl hover:scale-105 transition transform flex items-center justify-center gap-3 mx-auto">
                <span>Ingresar a los Ejercicios</span>
                <i class="fa-solid fa-circle-arrow-right"></i>
            </button>
        </div>

        <!-- ================= SECCIÓN 01: SELECCIÓN DE CATEGORÍA MATRIZ ================= -->
        <div id="initialChoiceSection" class="w-full max-w-3xl hidden space-y-8 animate-in fade-in duration-300">
            <div class="text-center space-y-2">
                <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">Elección de Contenidos</h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm">Selecciona una de las áreas temáticas para acceder a sus guías y quizzes.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Tarjeta 1: Geometría (Semejanza y Tales) -->
                <div onclick="goToGeometriaMenu()" class="glass-card p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-indigo-500 shadow-md hover:shadow-xl transition duration-300 cursor-pointer flex flex-col justify-between group">
                    <div class="space-y-4">
                        <div class="w-14 h-14 rounded-2xl bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-2xl group-hover:bg-indigo-600 group-hover:text-white transition duration-300">
                            <i class="fa-solid fa-draw-polygon"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition">Semejanza de Figuras</h3>
                            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Teorema de Tales, Corolario en Triángulos, Escalas y Figuras Planas.</p>
                        </div>
                    </div>
                    <div class="mt-6 flex items-center justify-between text-indigo-600 dark:text-indigo-400 font-bold text-sm">
                        <span>Ver 5 Temas</span>
                        <i class="fa-solid fa-arrow-right transform group-hover:translate-x-1 transition"></i>
                    </div>
                </div>

                <!-- Tarjeta 2: Procedimientos Básicos -->
                <div onclick="goToProcedimientosMenu()" class="glass-card p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-emerald-500 shadow-md hover:shadow-xl transition duration-300 cursor-pointer flex flex-col justify-between group">
                    <div class="space-y-4">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-2xl group-hover:bg-emerald-600 group-hover:text-white transition duration-300">
                            <i class="fa-solid fa-calculator"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition">Procedimientos Básicos</h3>
                            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Operaciones fundamentales: Suma, Resta, Multiplicación y División.</p>
                        </div>
                    </div>
                    <div class="mt-6 flex items-center justify-between text-emerald-600 dark:text-emerald-400 font-bold text-sm">
                        <span>Ver 4 Temas</span>
                        <i class="fa-solid fa-arrow-right transform group-hover:translate-x-1 transition"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= SECCIÓN 02A: MENÚ DE GEOMETRÍA ================= -->
        <div id="geometriaMenuSection" class="w-full max-w-4xl hidden space-y-6 animate-in fade-in duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-black text-slate-900 dark:text-white">Semejanza de Figuras y Tales</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-xs">Selecciona la guía que deseas resolver</p>
                </div>
                <button onclick="goToInitialChoice()" class="text-xs text-indigo-600 dark:text-indigo-400 font-bold hover:underline">
                    <i class="fa-solid fa-chevron-left mr-1"></i> Volver a Elección
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                <div onclick="startQuiz('semejanza')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-indigo-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-shapes text-indigo-600 dark:text-indigo-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">1. Semejanza de Figuras</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Razones de semejanza $k$ y lados homólogos proporcionales.</p>
                </div>

                <div onclick="startQuiz('tales')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-indigo-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-bars-staggered text-indigo-600 dark:text-indigo-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">2. Teorema de Tales</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Líneas paralelas cortadas por transversales ($L_1 \parallel L_2 \parallel L_3$).</p>
                </div>

                <div onclick="startQuiz('corolario')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-purple-500 shadow-sm hover:shadow-md cursor-pointer transition ring-2 ring-purple-100 dark:ring-purple-900/30">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-triangle-exclamation text-purple-600 dark:text-purple-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">3. Corolario en Triángulos</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Triángulos superpuestos con recta paralela interior y forma de mariposa.</p>
                </div>

                <div onclick="startQuiz('escalas')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-indigo-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-ruler-combined text-indigo-600 dark:text-indigo-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">4. Escalas y Mapas</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Cálculo de distancias reales en planos y mapas a escala.</p>
                </div>

                <div onclick="startQuiz('figuras_planas')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-indigo-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-vector-square text-indigo-600 dark:text-indigo-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">5. Resolución de Figuras Planas</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Cálculo de lados, perímetros y áreas en polígonos semejantes.</p>
                </div>
            </div>
        </div>

        <!-- ================= SECCIÓN 02B: MENÚ DE PROCEDIMIENTOS BÁSICOS ================= -->
        <div id="procedimientosMenuSection" class="w-full max-w-4xl hidden space-y-6 animate-in fade-in duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-black text-slate-900 dark:text-white">Procedimientos Básicos</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-xs">Selecciona la operación para practicar</p>
                </div>
                <button onclick="goToInitialChoice()" class="text-xs text-emerald-600 dark:text-emerald-400 font-bold hover:underline">
                    <i class="fa-solid fa-chevron-left mr-1"></i> Volver a Elección
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                <div onclick="startQuiz('suma')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-emerald-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-plus text-emerald-600 dark:text-emerald-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">1. Suma</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Ejercicios interactivos de adición básica y avanzada.</p>
                </div>

                <div onclick="startQuiz('resta')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-emerald-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-minus text-emerald-600 dark:text-emerald-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">2. Resta</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Sustracción y resolución de diferencias sencillas.</p>
                </div>

                <div onclick="startQuiz('multiplicacion')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-emerald-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-xmark text-emerald-600 dark:text-emerald-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">3. Multiplicación</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Tablas y producto entre números enteros.</p>
                </div>

                <div onclick="startQuiz('division')" class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-emerald-400 shadow-sm hover:shadow-md cursor-pointer transition">
                    <div class="flex items-center gap-3 mb-2">
                        <i class="fa-solid fa-divide text-emerald-600 dark:text-emerald-400 text-xl"></i>
                        <h4 class="font-bold text-slate-900 dark:text-white">4. División</h4>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Cálculo de cocientes y reparto proporcional.</p>
                </div>
            </div>
        </div>

        <!-- ================= SECCIÓN 03: INTERFAZ DEL QUIZ ================= -->
        <div id="quizSection" class="w-full max-w-2xl hidden space-y-6 animate-in fade-in duration-300">
            <div class="flex items-center justify-between border-b pb-4 border-slate-200 dark:border-slate-700">
                <span id="questionCounter" class="text-xs font-extrabold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950 px-3 py-1 rounded-full">Pregunta 1 de 5</span>
                <button onclick="goToInitialChoice()" class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-white font-semibold">Abandonar</button>
            </div>

            <div id="questionText" class="text-lg font-bold text-slate-800 dark:text-slate-100 leading-snug"></div>

            <div id="questionSvg" class="w-full"></div>

            <div id="optionsContainer" class="space-y-3"></div>

            <div id="explanationBox" class="hidden"></div>

            <div class="flex justify-end pt-4">
                <button id="checkBtn" onclick="checkAnswer()" class="px-6 py-3 rounded-xl gradient-bg text-white font-bold text-sm shadow-md hover:shadow-lg transition">
                    Comprobar Respuesta
                </button>
                <button id="nextBtn" onclick="nextQuestion()" class="hidden px-6 py-3 rounded-xl bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 dark:hover:bg-slate-600 text-white font-bold text-sm shadow-md transition">
                    Siguiente Pregunta <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>

        <!-- ================= SECCIÓN 04: RESUMEN Y RESULTADOS ================= -->
        <div id="summarySection" class="w-full max-w-md hidden text-center space-y-6 animate-in fade-in duration-300">
            <div class="w-20 h-20 bg-emerald-100 dark:bg-emerald-900/50 text-emerald-600 dark:text-emerald-400 rounded-full flex items-center justify-center mx-auto text-3xl shadow-inner">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <div>
                <h3 class="text-2xl font-black text-slate-900 dark:text-white">¡Quiz Completado!</h3>
                <p id="summaryUserGreeting" class="text-xs font-bold text-indigo-600 dark:text-indigo-400 mt-1"></p>
                <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">Tu puntaje se ha guardado en el ranking global.</p>
            </div>

            <div class="glass-card p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
                <span class="text-xs font-bold text-slate-400 uppercase">Puntaje Obtenido</span>
                <div id="scoreText" class="text-4xl font-black text-indigo-600 dark:text-indigo-400">0 / 5</div>
            </div>

            <div class="flex gap-4">
                <button onclick="restartCurrentQuiz()" class="flex-1 py-3 rounded-xl border border-slate-300 dark:border-slate-600 font-bold text-slate-700 dark:text-slate-200 text-sm hover:bg-slate-50 dark:hover:bg-slate-800 transition">
                    Repetir Quiz
                </button>
                <button onclick="goToInitialChoice()" class="flex-1 py-3 rounded-xl gradient-bg text-white font-bold text-sm shadow-md hover:shadow-lg transition">
                    Menú Principal
                </button>
            </div>
        </div>

    </main>

    <!-- ================= MODAL DE CONFIGURACIÓN ================= -->
    <div id="settingsModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="glass-card w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xl p-6 space-y-6 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between border-b pb-4 border-slate-200 dark:border-slate-700">
                <div class="flex items-center space-x-2 text-slate-900 dark:text-white font-bold text-lg">
                    <i class="fa-solid fa-gear text-indigo-600 dark:text-indigo-400"></i>
                    <span>Configuración</span>
                </div>
                <button onclick="closeSettingsModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm font-bold">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="space-y-4">
                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700">
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
                            <i class="fa-solid fa-moon"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm text-slate-900 dark:text-white">Modo Oscuro</h4>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Cambia la apariencia visual de la plataforma</p>
                        </div>
                    </div>
                    <!-- Toggle Switch -->
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="darkModeToggle" onchange="toggleDarkMode()" class="sr-only peer">
                        <div class="w-11 h-6 bg-slate-300 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                    </label>
                </div>
            </div>

            <div class="flex justify-end pt-2">
                <button onclick="closeSettingsModal()" class="px-5 py-2.5 rounded-xl gradient-bg text-white font-bold text-sm shadow-md hover:shadow-lg transition">
                    Guardar y Cerrar
                </button>
            </div>
        </div>
    </div>

    <!-- ================= MODAL DE RANKING GLOBAL (FIREBASE) ================= -->
    <div id="rankingModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="glass-card w-full max-w-md rounded-2xl border border-slate-200 dark:border-slate-700 shadow-2xl p-6 space-y-4 animate-in fade-in zoom-in duration-200">
            <div class="flex items-center justify-between border-b pb-3 border-slate-200 dark:border-slate-700">
                <div class="flex items-center space-x-2 text-slate-900 dark:text-white font-bold text-lg">
                    <i class="fa-solid fa-trophy text-amber-500"></i>
                    <span>Tabla de Ranking Global</span>
                </div>
                <button onclick="closeRankingModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm font-bold">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div id="rankingListContainer" class="space-y-2 max-h-64 overflow-y-auto pr-1">
                <!-- Se inyecta dinámicamente desde Firestore -->
                <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800 text-center text-xs text-slate-500">
                    Cargando los mejores puntajes...
                </div>
