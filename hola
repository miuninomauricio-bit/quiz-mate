                window.fetchRankingDataFromFirebase();
            }
        }

        function closeRankingModal() {
            document.getElementById('rankingModal').classList.add('hidden');
        }

        function enterPlatform() {
            const usernameInput = document.getElementById('usernameInput').value.trim();
            if (usernameInput !== "") {
                currentUser.name = usernameInput;
            }
            goToInitialChoice();
        }

        function hideAllSections() {
            document.getElementById('coverSection').classList.add('hidden');
            document.getElementById('initialChoiceSection').classList.add('hidden');
            document.getElementById('geometriaMenuSection').classList.add('hidden');
            document.getElementById('procedimientosMenuSection').classList.add('hidden');
            document.getElementById('quizSection').classList.add('hidden');
            document.getElementById('summarySection').classList.add('hidden');
        }

        function goToCover() {
            hideAllSections();
            document.getElementById('coverSection').classList.remove('hidden');
            document.getElementById('navBackBtn').classList.add('hidden');
            document.getElementById('rankingBtn').classList.add('hidden');
        }

        function goToInitialChoice() {
            hideAllSections();
            document.getElementById('initialChoiceSection').classList.remove('hidden');
            document.getElementById('navBackBtn').classList.remove('hidden');
            document.getElementById('rankingBtn').classList.remove('hidden');
        }

        function goToGeometriaMenu() {
            hideAllSections();
            document.getElementById('geometriaMenuSection').classList.remove('hidden');
        }

        function goToProcedimientosMenu() {
            hideAllSections();
            document.getElementById('procedimientosMenuSection').classList.remove('hidden');
        }

        function getRandomInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function startQuiz(topicKey) {
            currentTopic = topicKey;
            questionsList = generateQuestions(topicKey, 5);
            currentQuestionIndex = 0;
            score = 0;

            hideAllSections();
            document.getElementById('quizSection').classList.remove('hidden');
            renderQuestion();
        }

        function restartCurrentQuiz() {
            startQuiz(currentTopic);
        }

        function generateQuestions(topicKey, count) {
            const questions = [];
            for (let i = 0; i < count; i++) {
                if (topicKey === 'suma') {
                    const a = getRandomInt(10, 99);
                    const b = getRandomInt(10, 99);
                    const ans = a + b;
                    questions.push({
                        title: `Suma: ¿Cuál es el resultado de ${a} + ${b}?`,
                        svg: `<div class="p-4 bg-emerald-50 dark:bg-emerald-950/50 rounded-xl font-bold text-2xl text-emerald-800 dark:text-emerald-300 text-center">${a} + ${b} = ?</div>`,
                        ans: ans,
                        options: [ans, ans + getRandomInt(1, 5), ans - getRandomInt(1, 5), ans + 10].sort(() => Math.random() - 0.5),
                        explanation: `Para sumar ${a} + ${b}, sumamos las unidades y decenas: ${a} + ${b} = ${ans}.`
                    });
                } else if (topicKey === 'resta') {
                    const a = getRandomInt(30, 99);
                    const b = getRandomInt(10, a - 1);
                    const ans = a - b;
                    questions.push({
                        title: `Resta: ¿Cuál es el resultado de ${a} - ${b}?`,
                        svg: `<div class="p-4 bg-rose-50 dark:bg-rose-950/50 rounded-xl font-bold text-2xl text-rose-800 dark:text-rose-300 text-center">${a} - ${b} = ?</div>`,
                        ans: ans,
                        options: [ans, ans + getRandomInt(1, 5), ans - getRandomInt(1, 3), ans + 8].sort(() => Math.random() - 0.5),
                        explanation: `Al restar ${b} a ${a}, obtenemos ${ans}.`
                    });
                } else if (topicKey === 'multiplicacion') {
                    const a = getRandomInt(2, 12);
                    const b = getRandomInt(2, 12);
                    const ans = a * b;
                    questions.push({
                        title: `Multiplicación: ¿Cuánto es ${a} × ${b}?`,
                        svg: `<div class="p-4 bg-amber-50 dark:bg-amber-950/50 rounded-xl font-bold text-2xl text-amber-800 dark:text-amber-300 text-center">${a} × ${b} = ?</div>`,
                        ans: ans,
                        options: [ans, ans + a, ans - b, (a + 1) * b].sort(() => Math.random() - 0.5),
                        explanation: `Multiplicando ${a} por ${b} obtenemos ${ans}.`
                    });
                } else if (topicKey === 'division') {
                    const b = getRandomInt(2, 10);
                    const ans = getRandomInt(2, 10);
                    const a = b * ans;
                    questions.push({
                        title: `División: ¿Cuánto es ${a} ÷ ${b}?`,
                        svg: `<div class="p-4 bg-sky-50 dark:bg-sky-950/50 rounded-xl font-bold text-2xl text-sky-800 dark:text-sky-300 text-center">${a} ÷ ${b} = ?</div>`,
                        ans: ans,
                        options: [ans, ans + 1, ans + 2, ans > 2 ? ans - 1 : ans + 3].sort(() => Math.random() - 0.5),
                        explanation: `Dividiendo ${a} entre ${b} obtenemos ${ans} porque ${b} × ${ans} = ${a}.`
                    });
                } else if (topicKey === 'tales') {
                    const a = getRandomInt(4, 12);
                    const b = getRandomInt(2, 8);
                    const factor = getRandomInt(2, 4);
                    const c = a * factor;
                    const ans = b * factor;
                    const bcProduct = b * c;
                    questions.push({
                        title: `Teorema de Tales: Calcula la incógnita x en la figura de rectas paralelas $L_1 \\parallel L_2 \\parallel L_3$.`,
                        svg: `<div class="my-3 p-3 bg-slate-50 dark:bg-slate-800 border dark:border-slate-700 rounded-xl text-center">
                            <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 block mb-2">Diagrama: Proporción $\\frac{${a}}{${b}} = \\frac{${c}}{x}$</span>
                            <svg viewBox="0 0 300 120" class="w-full max-w-xs mx-auto stroke-slate-800 dark:stroke-slate-200">
                                <line x1="10" y1="20" x2="290" y2="20" stroke="#6366f1" stroke-width="2"/>
                                <line x1="10" y1="60" x2="290" y2="60" stroke="#6366f1" stroke-width="2"/>
                                <line x1="10" y1="100" x2="290" y2="100" stroke="#6366f1" stroke-width="2"/>
                                <line x1="60" y1="10" x2="100" y2="110" stroke="currentColor" stroke-width="2"/>
                                <line x1="240" y1="10" x2="200" y2="110" stroke="currentColor" stroke-width="2"/>
                                <text x="70" y="45" font-size="12" fill="#818cf8">${a}</text>
                                <text x="85" y="85" font-size="12" fill="#818cf8">${b}</text>
                                <text x="230" y="45" font-size="12" fill="#818cf8">${c}</text>
                                <text x="215" y="85" font-size="12" fill="#fbbf24" font-weight="bold">x</text>
                            </svg>
                        </div>`,
                        ans: ans,
                        options: [ans, ans + 2, ans + 4, Math.max(1, ans - 2)].sort(() => Math.random() - 0.5),
                        explanation: `Ordenando los segmentos en proporción: $\\frac{${a}}{${b}} = \\frac{${c}}{x} \\implies ${a}x = ${bcProduct} \\implies x = ${ans}$.`
                    });
                } else if (topicKey === 'corolario') {
                    const mode = i % 2; 
                    if (mode === 0) {
                        const ad = getRandomInt(3, 8);
                        const db = getRandomInt(2, 6);
                        const factor = getRandomInt(2, 3);
                        const ae = ad * factor;
                        const ans = db * factor;
                        
                        questions.push({
                            title: `Corolario de Tales en Triángulos: En el $\\triangle ABC$, la recta $DE$ es paralela a $BC$. Calcula $x = EC$.`,
                            svg: `<div class="my-3 p-3 bg-slate-50 dark:bg-slate-800 border dark:border-slate-700 rounded-xl text-center">
                                <span class="text-xs font-bold text-purple-600 dark:text-purple-400 block mb-2">Triángulo con Recta Paralela ($DE \\parallel BC$)</span>
                                <svg viewBox="0 0 280 150" class="w-full max-w-xs mx-auto">
                                    <polygon points="140,15 30,135 250,135" fill="none" stroke="#a78bfa" stroke-width="2"/>
                                    <line x1="74" y1="87" x2="206" y2="87" stroke="#60a5fa" stroke-width="3"/>
                                    <text x="140" y="10" font-size="11" font-weight="bold" text-anchor="middle" fill="#c4b5fd">A</text>
                                    <text x="20" y="145" font-size="11" font-weight="bold" fill="#c4b5fd">B</text>
                                    <text x="255" y="145" font-size="11" font-weight="bold" fill="#c4b5fd">C</text>
                                    <text x="60" y="85" font-size="11" font-weight="bold" fill="#60a5fa">D</text>
                                    <text x="212" y="85" font-size="11" font-weight="bold" fill="#60a5fa">E</text>
                                    <text x="90" y="50" font-size="11" fill="#c4b5fd" font-weight="bold">AD = ${ad}</text>
                                    <text x="40" y="115" font-size="11" fill="#c4b5fd" font-weight="bold">DB = ${db}</text>
                                    <text x="175" y="50" font-size="11" fill="#c4b5fd" font-weight="bold">AE = ${ae}</text>
                                    <text x="225" y="115" font-size="11" fill="#fbbf24" font-weight="bold">x</text>
                                </svg>
                            </div>`,
                            ans: ans,
                            options: [ans, ans + 2, Math.max(1, ans - 1), ans + 3].sort(() => Math.random() - 0.5),
                            explanation: `Por el Corolario de Tales en el triángulo, la paralela corta los lados proporcionalmente: $\\frac{AD}{DB} = \\frac{AE}{EC} \\implies \\frac{${ad}}{${db}} = \\frac{${ae}}{x} \\implies x = ${ans}$.`
                        });
                    } else {
                        const a = getRandomInt(3, 9);
                        const b = getRandomInt(2, 6);
                        const k = getRandomInt(2, 3);
                        const c = a * k;
                        const ans = b * k;
                        questions.push({
                            title: `Corolario del Teorema de Tales: Encuentra el valor de x en la figura de triángulos semejantes opuestos por el vértice.`,
                            svg: `<div class="my-3 p-3 bg-slate-50 dark:bg-slate-800 border dark:border-slate-700 rounded-xl text-center">
                                <span class="text-xs font-bold text-purple-600 dark:text-purple-400 block mb-2">Reloj de Arena / Triángulos Semejantes</span>
                                <svg viewBox="0 0 300 130" class="w-full max-w-xs mx-auto">
                                    <polygon points="40,20 260,20 40,110 260,110" fill="none" stroke="#a78bfa" stroke-width="2"/>
                                    <line x1="40" y1="20" x2="260" y2="20" stroke="#60a5fa" stroke-width="3"/>
                                    <line x1="40" y1="110" x2="260" y2="110" stroke="#60a5fa" stroke-width="3"/>
                                    <text x="130" y="15" font-size="11" text-anchor="middle" fill="#93c5fd">Bases Paralelas</text>
                                    <text x="110" y="40" font-size="12" fill="#c4b5fd">${a}</text>
                                    <text x="175" y="40" font-size="12" fill="#c4b5fd">${b}</text>
                                    <text x="100" y="95" font-size="12" fill="#c4b5fd">${c}</text>
                                    <text x="185" y="95" font-size="12" fill="#fbbf24" font-weight="bold">x</text>
                                </svg>
                            </div>`,
                            ans: ans,
                            options: [ans, ans + 1, ans + 3, Math.max(1, ans - 1)].sort(() => Math.random() - 0.5),
                            explanation: `Por el Corolario de Tales (triángulos semejantes formados por las transversales): $\\frac{${a}}{${c}} = \\frac{${b}}{x} \\implies x = ${ans}$.`
                        });
                    }
                } else if (topicKey === 'escalas') {
                    const realDistKm = getRandomInt(2, 10);
                    const scaleFactor = 100000;
                    const ansCm = realDistKm * 10;
                    questions.push({
                        title: `Escalas: En un mapa a escala $1:${scaleFactor}$, la distancia real entre dos ciudades es de ${realDistKm} km. ¿Cuántos centímetros mide en el mapa?`,
                        svg: `<div class="p-3 bg-indigo-50 dark:bg-indigo-950/50 rounded-xl text-center font-bold text-indigo-900 dark:text-indigo-300 text-sm">Escala 1 : ${scaleFactor} | Distancia Real = ${realDistKm} km</div>`,
                        ans: ansCm,
                        options: [ansCm, ansCm * 2, ansCm / 2, ansCm + 5].sort(() => Math.random() - 0.5),
                        explanation: `Convertimos ${realDistKm} km a cm ($${realDistKm} \\times 100.000 = ${realDistKm * 100000}$ cm). Luego dividimos entre la escala: $${realDistKm * 100000} \\div ${scaleFactor} = ${ansCm}$ cm.`
                    });
                } else if (topicKey === 'figuras_planas') {
                    const b1 = getRandomInt(3, 8);
                    const h1 = getRandomInt(4, 10);
                    const k = getRandomInt(2, 4);
                    const b2 = b1 * k;
                    const ansH2 = h1 * k;
                    const perim1 = 2 * (b1 + h1);
                    const ansPerim2 = perim1 * k;

                    const type = getRandomInt(1, 2);
                    if (type === 1) {
                        questions.push({
                            title: `Resolución de Figuras Planas: Dos rectángulos son semejantes. El primero tiene base ${b1} cm y altura ${h1} cm. Si la base del segundo es de ${b2} cm, ¿cuál es su altura ($h_2$)?`,
                            svg: `<div class="my-3 p-3 bg-slate-50 dark:bg-slate-800 border dark:border-slate-700 rounded-xl text-center">
                                <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 block mb-2">Rectángulos Semejantes</span>
                                <svg viewBox="0 0 280 100" class="w-full max-w-xs mx-auto">
                                    <rect x="20" y="30" width="40" height="50" fill="none" stroke="#818cf8" stroke-width="2"/>
                                    <text x="40" y="22" font-size="10" text-anchor="middle" fill="#818cf8">${b1} cm</text>
                                    <text x="10" y="58" font-size="10" text-anchor="middle" fill="#818cf8">${h1} cm</text>
                                    
                                    <rect x="140" y="10" width="80" height="80" fill="none" stroke="#818cf8" stroke-width="2"/>
                                    <text x="180" y="8" font-size="10" text-anchor="middle" fill="#818cf8">${b2} cm</text>
                                    <text x="125" y="55" font-size="10" text-anchor="middle" fill="#fbbf24" font-weight="bold">h₂ = ?</text>
                                </svg>
                            </div>`,
                            ans: ansH2,
                            options: [ansH2, ansH2 + 2, ansH2 - 1 > 0 ? ansH2 - 1 : ansH2 + 3, ansH2 * 2].sort(() => Math.random() - 0.5),
                            explanation: `Calculamos la razón de semejanza $k = \\frac{${b2}}{${b1}} = ${k}$. Luego multiplicamos la altura por $k$: $h_2 = ${h1} \\times ${k} = ${ansH2}$ cm.`
                        });
                    } else {
                        questions.push({
                            title: `Resolución de Figuras Planas: Un rectángulo tiene un perímetro de ${perim1} cm. Se construye un rectángulo semejante con razón $k = ${k}$. ¿Cuál es el perímetro de la nueva figura plana?`,
                            svg: `<div class="p-3 bg-indigo-50 dark:bg-indigo-950/50 rounded-xl text-center font-bold text-indigo-900 dark:text-indigo-300 text-sm">Perímetro inicial $P_1 = ${perim1}$ cm | Razón $k = ${k}$</div>`,
                            ans: ansPerim2,
                            options: [ansPerim2, ansPerim2 + 4, perim1 * (k * k), Math.max(2, ansPerim2 - 6)].sort(() => Math.random() - 0.5),
                            explanation: `La razón entre los perímetros de figuras semejantes es igual a la razón de semejanza lineal $k$. Por lo tanto, $P_2 = P_1 \\times k = ${perim1} \\times ${k} = ${ansPerim2}$ cm.`
                        });
                    }
                } else { // semejanza
                    const base1 = getRandomInt(4, 10);
                    const k = getRandomInt(2, 5);
                    const base2 = base1 * k;
                    const ansAreaRatio = k * k;
                    questions.push({
                        title: `Semejanza: Un rectángulo de base ${base1} cm se amplía a una base de ${base2} cm en la misma proporción. ¿Cuántas veces es mayor el área del nuevo rectángulo?`,
                        svg: `<div class="p-3 bg-purple-50 dark:bg-purple-950/50 rounded-xl text-center font-bold text-purple-900 dark:text-purple-300 text-sm">Razón de semejanza $k = \\frac{${base2}}{${base1}} = ${k}$</div>`,
                        ans: ansAreaRatio,
                        options: [ansAreaRatio, k, k * 2, ansAreaRatio + 2].sort(() => Math.random() - 0.5),
                        explanation: `La razón de semejanza lineal es $k = ${k}$. La razón entre las áreas es $k^2 = ${k}^2 = ${ansAreaRatio}$ veces mayor.`
                    });
                }
            }
            return questions;
        }

        function renderQuestion() {
            selectedOption = null;
            const q = questionsList[currentQuestionIndex];
            
            document.getElementById('questionCounter').innerText = `Pregunta ${currentQuestionIndex + 1} de ${questionsList.length}`;
            document.getElementById('questionText').innerHTML = q.title;
            document.getElementById('questionSvg').innerHTML = q.svg || '';
            
            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';
            
            q.options.forEach((opt) => {
                const btn = document.createElement('button');
                btn.className = 'w-full text-left p-4 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 bg-white dark:bg-slate-800 hover:bg-indigo-50/50 dark:hover:bg-slate-700/50 font-medium text-sm text-slate-800 dark:text-slate-100 transition flex items-center justify-between group';
                btn.setAttribute('data-value', opt);
                btn.onclick = () => selectOption(btn, opt);
                btn.innerHTML = `<span>${opt}</span><div class="option-icon-container w-5 h-5 rounded-full border border-slate-300 dark:border-slate-600 group-hover:border-indigo-500 flex items-center justify-center text-xs text-white">✓</div>`;
                container.appendChild(btn);
            });

            document.getElementById('explanationBox').className = 'hidden';
            document.getElementById('checkBtn').classList.remove('hidden');
            document.getElementById('nextBtn').classList.add('hidden');

            if (window.MathJax) {
                MathJax.typesetPromise();
            }
        }

        function selectOption(btnElement, value) {
            selectedOption = value;
            const buttons = document.querySelectorAll('#optionsContainer button');
            buttons.forEach(b => {
                b.classList.remove('border-indigo-600', 'bg-indigo-50', 'dark:bg-indigo-950', 'ring-2', 'ring-indigo-200', 'dark:ring-indigo-800');
            });
            btnElement.classList.add('border-indigo-600', 'bg-indigo-50', 'dark:bg-indigo-950/50', 'ring-2', 'ring-indigo-200', 'dark:ring-indigo-800');
        }

        function checkAnswer() {
            if (selectedOption === null) return;
            
            const q = questionsList[currentQuestionIndex];
            const isCorrect = selectedOption === q.ans;
            
            if (isCorrect) score++;

            const buttons = document.querySelectorAll('#optionsContainer button');
            buttons.forEach(btn => {
                btn.disabled = true;
                btn.classList.remove('hover:border-indigo-400', 'hover:bg-indigo-50/50', 'cursor-pointer');
                btn.classList.add('cursor-default');

                const optValue = parseFloat(btn.getAttribute('data-value'));
                const iconContainer = btn.querySelector('.option-icon-container');

                if (optValue === q.ans) {
                    btn.classList.remove('border-slate-200', 'dark:border-slate-700', 'bg-white', 'dark:bg-slate-800', 'border-indigo-600', 'bg-indigo-50', 'ring-2', 'ring-indigo-200');
                    btn.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/50', 'text-emerald-900', 'dark:text-emerald-200', 'font-bold');
                    iconContainer.className = 'option-icon-container w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center text-xs shadow-sm';
                    iconContainer.innerHTML = '<i class="fa-solid fa-check"></i>';
                } else if (optValue === selectedOption && !isCorrect) {
                    btn.classList.remove('border-slate-200', 'dark:border-slate-700', 'bg-white', 'dark:bg-slate-800', 'border-indigo-600', 'bg-indigo-50', 'ring-2', 'ring-indigo-200');
                    btn.classList.add('border-rose-500', 'bg-rose-50', 'dark:bg-rose-950/50', 'text-rose-900', 'dark:text-rose-200', 'font-bold');
                    iconContainer.className = 'option-icon-container w-6 h-6 rounded-full bg-rose-500 text-white flex items-center justify-center text-xs shadow-sm';
                    iconContainer.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                } else {
                    btn.classList.add('opacity-50');
                }
            });

            const expBox = document.getElementById('explanationBox');
            expBox.className = `p-4 rounded-xl text-sm ${isCorrect ? 'bg-emerald-50 dark:bg-emerald-950/50 text-emerald-900 dark:text-emerald-200 border border-emerald-200 dark:border-emerald-800' : 'bg-rose-50 dark:bg-rose-950/50 text-rose-900 dark:text-rose-200 border border-rose-200 dark:border-rose-800'} space-y-1`;
            expBox.innerHTML = `
                <div class="font-bold flex items-center gap-2">
                    <i class="fa-solid ${isCorrect ? 'fa-circle-check text-emerald-600 dark:text-emerald-400' : 'fa-circle-xmark text-rose-600 dark:text-rose-400'}"></i>
                    <span>${isCorrect ? '¡Correcto!' : 'Respuesta Incorrecta'}</span>
                </div>
                <p class="text-xs">${q.explanation}</p>
            `;

            document.getElementById('checkBtn').classList.add('hidden');
            document.getElementById('nextBtn').classList.remove('hidden');

            if (window.MathJax) {
                MathJax.typesetPromise();
            }
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < questionsList.length) {
                renderQuestion();
            } else {
                showSummary();
            }
        }

        function showSummary() {
            hideAllSections();
            document.getElementById('summarySection').classList.remove('hidden');
            document.getElementById('scoreText').innerText = `${score} / ${questionsList.length}`;
            document.getElementById('summaryUserGreeting').innerText = `Jugador: ${currentUser.name}`;

            currentUser.score = score;
            currentUser.topic = currentTopic;
            
            if (window.sendScoreToFirebase) {
                window.sendScoreToFirebase(currentUser);
            }
        }
    </script>
</body>
</html>
